# Copy this file to .env and fill in your values.
# .env is never committed — add it to .gitignore.

# AWS credentials (if not using ~/.aws/credentials or an IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=          # only needed for temporary/assumed-role credentials

# AWS region hosting your Bedrock endpoint
AWS_DEFAULT_REGION=us-east-1

# Bedrock model ID override (optional — defaults to claude-3-5-sonnet)
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
