{
  "id": "test_generator",
  "name": "Test Generator & Executor",
  "version": "2.0.0",
  "type": "sub-agent",
  "trigger": "on_demand",
  "requires_tools": [
    "browser_navigate",
    "browser_snapshot",
    "browser_click",
    "browser_type",
    "browser_screenshot",
    "browser_console_messages",
    "browser_network_requests",
    "browser_evaluate",
    "browser_run_code"
  ],
  "model_tier": "sub",
  "input_format": "mission_brief_markdown",
  "output_format": "findings_json",
  "description": "Generates and executes test cases for the full site based on the site map. Returns structured findings."
}
